# Instagram Graph API Credentials
# Configure these in GitHub Repository -> Settings -> Secrets and variables -> Actions
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_long_lived_instagram_access_token

# Gemini AI API Key (for Hinglish Captions)
GEMINI_API_KEY=your_gemini_api_key

# NOTE: No external cloud storage or PUBLIC_MEDIA_BASE_URL needed!
# Videos are automatically hosted on GitHub Release assets for Meta's API to fetch.
