# Instagram Graph API Credentials
# Replace these with your actual credentials or configure in GitHub Repository Secrets
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_long_lived_instagram_access_token

# Gemini AI API Key (for Hinglish Captions)
GEMINI_API_KEY=your_gemini_api_key

# Public Base URL or cloud storage URL where processed videos are reachable for Instagram API
# (Instagram requires a public HTTPS URL to download the video container)
PUBLIC_MEDIA_BASE_URL=
